[Unit]
Description=Igris network process investigation daemon
Documentation=https://localhost:8787
After=network.target

[Service]
Type=simple
User=root
Group=root
Environment=IGRIS_BIND_MODE=localhost
EnvironmentFile=-/etc/igris/igris.env
ExecStart=/opt/igris/.venv/bin/igrisd
Restart=on-failure
RestartSec=3
StateDirectory=igris
StateDirectoryMode=0700
UMask=0077
WorkingDirectory=/var/lib/igris
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/igris
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
