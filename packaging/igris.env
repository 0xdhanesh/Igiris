# Use "localhost" for 127.0.0.1 or "network" for 0.0.0.0.
# An explicitly configured IGRIS_BIND_HOST overrides this mode for compatibility.
IGRIS_BIND_MODE=localhost
IGRIS_BIND_PORT=8787
IGRIS_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
IGRIS_PASSWORD_VERIFIER_FILE=/etc/igris/password.verifier
IGRIS_LOGIN_MAX_PARALLEL_CHECKS=2
IGRIS_SESSION_TTL_SECONDS=28800
IGRIS_LOGIN_MAX_FAILURES=5
IGRIS_LOGIN_FAILURE_WINDOW_SECONDS=60
IGRIS_DATABASE_PATH=/var/lib/igris/igris.db
IGRIS_RETENTION_HOURS=24
IGRIS_SOFT_DISK_CAP_MB=512
IGRIS_POLL_INTERVAL=1.0
IGRIS_EXEC_POLL_INTERVAL=0.2
IGRIS_PTR_FALLBACK=false
