IGIRIS_BIND_HOST=127.0.0.1
IGIRIS_BIND_PORT=8787
IGIRIS_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
IGIRIS_PASSWORD_VERIFIER_FILE=/etc/igiris/password.verifier
IGIRIS_LOGIN_MAX_PARALLEL_CHECKS=2
IGIRIS_SESSION_TTL_SECONDS=28800
IGIRIS_LOGIN_MAX_FAILURES=5
IGIRIS_LOGIN_FAILURE_WINDOW_SECONDS=60
IGIRIS_DATABASE_PATH=/var/lib/igiris/igiris.db
IGIRIS_RETENTION_HOURS=24
IGIRIS_SOFT_DISK_CAP_MB=512
IGIRIS_POLL_INTERVAL=1.0
IGIRIS_EXEC_POLL_INTERVAL=0.2
IGIRIS_PTR_FALLBACK=false
